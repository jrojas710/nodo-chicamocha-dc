# Copie como .env y complete. .env está en .gitignore: NUNCA se sube al repositorio.
# IoT Central > Permissions > Device connection groups > SAS-IoT-Devices
IOTC_ID_SCOPE=0neXXXXXXXX
IOTC_GROUP_KEY=clave_primaria_del_grupo_SAS_en_base64
# (Opcional) clave individual por dispositivo en lugar de la de grupo:
# IOTC_DEVICE_KEY_DC_RACK_A_PY=...
# DEV-05: clave gratuita de OpenWeather (si falta, se usa Open-Meteo)
OPENWEATHER_API_KEY=
SITE_LAT=7.1193
SITE_LON=-73.1227
LOG_LEVEL=INFO
