        "Telemetry",
        "Temperature"
      ],
      "schema": "double",
      "unit": "degreeCelsius"
    },
    {
      "name": "humidity",
      "displayName": {
        "es": "Humedad relativa"
      },
      "@type": [
        "Telemetry",
        "RelativeHumidity"
      ],
      "schema": "double",
      "unit": "percent"
    },
    {
      "name": "diffPressure",
      "displayName": {
        "es": "Presión diferencial frío-caliente"
      },
      "@type": [
        "Telemetry",
        "Pressure"
      ],
      "schema": "double",
      "unit": "pascal"
    },
    {
      "name": "dewPoint",
      "displayName": {
        "es": "Punto de rocío"
      },
      "@type": [
        "Telemetry",
        "Temperature"
      ],
      "schema": "double",
