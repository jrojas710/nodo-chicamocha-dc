      },
      "@type": "Property",
      "schema": "string",
      "writable": false
    },
    {
      "name": "sourceOrigin",
      "displayName": {
        "es": "Origen de envío declarado"
      },
      "@type": "Property",
      "schema": "string",
      "writable": false
